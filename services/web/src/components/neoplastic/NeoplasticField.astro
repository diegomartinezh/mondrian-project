---
/**
 * One neoplastic art plane: a static SVG twin (first paint, reduced motion, no script)
 * under a Canvas 2.5D field that takes over once mounted. Decorative: the canvas is
 * aria-hidden; meaning lives in the page's HTML (D-37, neoplasticizer skill).
 */
import { squaredSquareSVG } from "@mondrian/neoplastic/svg";

interface Props {
  mode?: "planes" | "descent" | "focus" | "static";
  depth?: number;
  seed?: number;
  fit?: "cover" | "contain";
  class?: string;
  /** Pointer root: "self" (default) or "page" (field follows the pointer anywhere). */
  pointer?: "self" | "page";
}

const { mode = "planes", depth = 1, seed = 7, fit = "cover", class: cls = "", pointer = "self" } = Astro.props;
const twin = squaredSquareSVG({ size: 1120, depth, splitAt: 314, seed }).replace(
  "<svg ",
  '<svg preserveAspectRatio="xMidYMid slice" class="np-field__twin" ',
);
---
<div
  class:list={["np-field", cls]}
  data-np-field={mode}
  data-np-seed={seed}
  data-np-fit={fit}
  data-np-pointer={pointer}
>
  <Fragment set:html={twin} />
  {mode !== "static" && <canvas class="np-field__canvas" aria-hidden="true"></canvas>}
</div>
