---
import "@mondrian/tokens";
import "@mondrian/matrix/styles/matrix.css";
import "../styles/chrome.css";
import "../styles/study.css";
import SiteNav from "../components/SiteNav.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  current?: string;
  noindex?: boolean;
  lang?: string;
}

const { title, current = "", noindex = false, lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const faviconHref = withBase("/favicon.svg", base);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteNav current={current} />
    <main id="main" class="shell-main">
      <slot />
    </main>
    <footer class="shell-footer">
      <p>Geometric studies after Mondrian · FE I / UDIT · Neoplastix</p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--mp-font-sans, "IBM Plex Sans", system-ui, sans-serif);
    background: var(--mp-color-canvas, #f4f2ed);
    color: var(--mp-color-ink, #121212);
  }
  a {
    color: inherit;
  }
</style>
