---
/**
 * v6 Moroń: nine unequal squares in a 33 × 32 rectangle (Moroń 1925), the smallest perfect
 * squared rectangle. A square that almost is. Colour cycles by hard cuts (CSS steps, the SVG
 * lesson's economy baseline); geometry never moves. Pause control per WCAG 2.2.2.
 */
import NeoplasticLanding from "../../../components/neoplastic/NeoplasticLanding.astro";
import { MORON_9, decodeBouwkamp } from "@mondrian/neoplastic";
const tiles = decodeBouwkamp(MORON_9);
const lw = 0.45;
---
<NeoplasticLanding variant="v6">
  <div slot="art" class="np-field np-moron" data-np-moron>
    <svg viewBox="-1.5 -2 36 36" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      {tiles.map((t) => (
        <rect class={`np-moron__sq np-moron__sq--${t.i}`} x={t.x} y={t.y} width={t.w} height={t.h} />
      ))}
      <g fill="none" stroke="var(--nx-role-black)" stroke-width={lw}>
        {tiles.map((t) => <rect x={t.x} y={t.y} width={t.w} height={t.h} />)}
      </g>
    </svg>
  </div>
  <div slot="math-note">
    <p class="np-math__note">Moroń (1925): 18, 15, 14, 10, 9, 8, 7, 4, 1. Nine squares, none equal, filling 33 × 32.</p>
    <p class="np-eq__controls"><button type="button" data-np-moron-toggle aria-pressed="false">Pause colour</button></p>
  </div>
</NeoplasticLanding>

<style is:global>
  .np-moron { display: grid; place-items: center; }
  .np-moron svg { width: 100%; height: 100%; }
  .np-moron__sq { fill: var(--nx-role-white); animation: np-moron 12s steps(1, end) infinite; }
  /* Colour roles walk across four squares; every cut is a hard step, never a blend. */
  .np-moron__sq--0 { animation-delay: 0s; }
  .np-moron__sq--1 { animation-delay: -3s; }
  .np-moron__sq--4 { animation-delay: -6s; }
  .np-moron__sq--6 { animation-delay: -9s; }
  .np-moron__sq:not(.np-moron__sq--0):not(.np-moron__sq--1):not(.np-moron__sq--4):not(.np-moron__sq--6) { animation: none; }
  @keyframes np-moron {
    0% { fill: var(--nx-role-red); }
    25% { fill: var(--nx-role-white); }
    50% { fill: var(--nx-role-blue); }
    75% { fill: var(--nx-role-yellow); }
  }
  .np-moron.is-paused .np-moron__sq { animation-play-state: paused; }
  .np-eq__controls { display: flex; gap: 0.5rem; margin: 0 0 1rem; }
  .np-eq__controls button { min-height: 44px; padding: 0 0.9rem; border: 2px solid currentColor; background: transparent; color: inherit; font: inherit; border-radius: 0; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) {
    .np-moron__sq { animation: none !important; }
    .np-moron__sq--0 { fill: var(--nx-role-red); }
    .np-moron__sq--1 { fill: var(--nx-role-blue); }
    .np-moron__sq--4 { fill: var(--nx-role-yellow); }
  }
</style>

<script>
  const art = document.querySelector("[data-np-moron]");
  const btn = document.querySelector<HTMLButtonElement>("[data-np-moron-toggle]");
  btn?.addEventListener("click", () => {
    const paused = art?.classList.toggle("is-paused") ?? false;
    btn.setAttribute("aria-pressed", String(paused));
    btn.textContent = paused ? "Play colour" : "Pause colour";
  });
</script>
